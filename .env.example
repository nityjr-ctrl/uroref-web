# Optional privacy-first aggregate analytics. Leave both unset to keep Umami disabled.
PUBLIC_UMAMI_SRC=https://analytics.example.org/script.js
PUBLIC_UMAMI_WEBSITE_ID=replace-with-site-id

# Required only for the separate live Ariadne evaluation command.
ARIADNE_EVAL_ENDPOINT=https://example.org/api/ariadne-eval
