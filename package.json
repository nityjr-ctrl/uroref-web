{
  "name": "uroref-web",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "node scripts/inject-build-ref.mjs && pagefind --site dist",
    "preview": "astro preview",
    "presentation": "astro preview --host 127.0.0.1 --port 4321",
    "astro": "astro",
    "build:assets": "node scripts/build-assets.mjs",
    "sync:prostateview": "node scripts/sync-prostateview-mirror.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:logos": "node scripts/check-logo-kit.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "eval:ariadne:fixtures": "node scripts/run-promptfoo.mjs eval -c evals/promptfoo.fixtures.yaml --no-cache",
    "eval:ariadne:live": "node scripts/run-promptfoo.mjs eval -c evals/promptfoo.live.yaml --no-cache"
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.8",
    "@astrojs/sitemap": "3.7.3",
    "@google/model-viewer": "4.3.1",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.2.10",
    "tailwindcss": "4.3.3",
    "three": "0.183.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "axe-core": "4.13.0",
    "jsqr": "^1.4.0",
    "pagefind": "1.5.2",
    "playwright": "1.62.1",
    "promptfoo": "0.122.1",
    "qrcode": "^1.5.4",
    "sharp": "0.35.4"
  },
  "overrides": {
    "onnxruntime-node": {
      "adm-zip": "0.6.0"
    }
  }
}
