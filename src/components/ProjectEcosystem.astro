---
import { ecosystemProjects } from '../data/ecosystem';

const projects = ecosystemProjects.filter((project) => project.id !== 'uroref');
---

<section class="project-ecosystem" aria-labelledby="project-ecosystem-title">
  <div class="project-ecosystem-inner">
    <div class="project-ecosystem-copy">
      <p class="project-ecosystem-kicker">UroRef ecosystem</p>
      <h2 id="project-ecosystem-title">One connected learning system.</h2>
      <p>
        Start with concise reference, then move into spatial anatomy, deliberate practice and source-labelled teaching—without losing the route back to the evidence.
      </p>
      <a class="project-ecosystem-cta" href="/showcase">Enter the UroRef Mega Hub →</a>
    </div>

    <div class="project-ecosystem-grid" aria-label="Related UroRef projects">
      {projects.map((project) => (
        <a class="project-card" style={`--project-accent:${project.accent}`} href={`/showcase#${project.id}`}>
          <span class="project-card-top">
            <span class="project-card-mark" aria-hidden="true">
              <img src={project.logo} alt="" width="38" height="38" loading="lazy" decoding="async" />
            </span>
            <span class="project-card-status">{project.stageLabel}</span>
          </span>
          <span class="project-card-eyebrow">{project.category}</span>
          <strong>{project.name}</strong>
          <span class="project-card-description">{project.description}</span>
          <span class="project-card-arrow">See in the hub →</span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .project-ecosystem {
    padding: 28px 32px 0;
    border-bottom: 1px solid var(--border);
  }

  .project-ecosystem-inner {
    max-width: var(--container);
    margin: 0 auto;
    border: 1px solid var(--border-strong);
    border-radius: var(--r-xl);
    background:
      radial-gradient(circle at 12% 0%, rgba(0, 212, 200, 0.16), transparent 34%),
      linear-gradient(135deg, rgba(255, 255, 255, 0.075), rgba(255, 255, 255, 0.025));
    box-shadow: 0 24px 70px -42px rgba(0, 0, 0, 0.9);
    padding: clamp(24px, 4vw, 38px);
    display: grid;
    grid-template-columns: minmax(260px, 0.82fr) minmax(0, 1.18fr);
    gap: clamp(22px, 4vw, 44px);
    align-items: center;
    overflow: hidden;
    position: relative;
  }

  .project-ecosystem-inner::after {
    content: '';
    position: absolute;
    inset: auto 24px 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(0, 212, 200, 0.65), transparent);
    opacity: 0.7;
  }

  .project-ecosystem-copy {
    position: relative;
    z-index: 1;
  }

  .project-ecosystem-kicker {
    margin: 0 0 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--teal-500);
  }

  .project-ecosystem h2 {
    margin: 0;
    font-size: clamp(28px, 4.2vw, 48px);
    line-height: 0.98;
    letter-spacing: -0.035em;
    font-weight: 600;
    max-width: 13ch;
    text-wrap: balance;
  }

  .project-ecosystem-copy > p:not(.project-ecosystem-kicker) {
    margin: 18px 0 0;
    max-width: 46ch;
    font-family: var(--font-serif);
    font-size: 16px;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .project-ecosystem-cta {
    display: inline-flex;
    margin-top: 20px;
    color: var(--teal-500);
    font-size: 14px;
    font-weight: 650;
  }

  .project-ecosystem-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .project-card {
    min-height: 186px;
    color: inherit;
    text-decoration: none;
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    background: rgba(2, 16, 30, 0.42);
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 9px;
    transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease;
  }

  .project-card:hover {
    transform: translateY(-2px);
    border-color: var(--project-accent);
    background: rgba(2, 16, 30, 0.64);
  }

  .project-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
  }

  .project-card-status {
    max-width: 16ch;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 8px;
    line-height: 1.35;
    letter-spacing: .07em;
    text-align: right;
    text-transform: uppercase;
  }

  .project-card-mark {
    width: 38px;
    height: 38px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--project-accent) 50%, transparent);
    background: #071321;
    box-shadow: 0 8px 24px -14px var(--project-accent);
  }

  .project-card-mark img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .project-card-arrow {
    margin-top: auto;
    color: var(--project-accent);
    font-size: 12px;
    font-weight: 650;
  }

  .project-card-eyebrow {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--project-accent);
  }

  .project-card strong {
    font-size: 20px;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }

  .project-card-description {
    color: var(--text-secondary);
    font-family: var(--font-serif);
    font-size: 14px;
    line-height: 1.45;
  }

  @media (max-width: 940px) {
    .project-ecosystem-inner {
      grid-template-columns: 1fr;
    }

    .project-ecosystem h2 {
      max-width: 18ch;
    }
  }

  @media (max-width: 640px) {
    .project-ecosystem {
      padding: 20px 20px 0;
    }

    .project-ecosystem-grid {
      grid-template-columns: 1fr;
    }

    .project-card {
      min-height: 0;
    }
  }
</style>
