---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import HubSearch from '../components/HubSearch.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  searchAudiences?: string[];
  searchTopics?: string[];
  searchContentType?: string;
}

const {
  title,
  description = "UroRef — evidence for UK urology trainees. A weekly publication on landmark trials, on-call pathways and FRCS-standard summaries, paired with the UroRef app.",
  image = '/og-image.png',
  searchAudiences: suppliedSearchAudiences,
  searchTopics: suppliedSearchTopics,
  searchContentType: suppliedSearchContentType,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
const ogImage = new URL(image, Astro.site ?? Astro.url);
const buildRef = import.meta.env.PUBLIC_BUILD_REF?.trim() || 'local';
const pathname = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? pathname === '/' : pathname.startsWith(href);
const searchContentType = suppliedSearchContentType
  ?? (pathname.startsWith('/deep-dives/') ? 'Deep Dive'
    : pathname === '/showcase/' || pathname === '/showcase' ? 'Hub'
    : pathname.startsWith('/imaging-lab') ? 'Lab'
    : pathname.startsWith('/app') ? 'App'
    : pathname.startsWith('/last30days') ? 'Governance'
    : 'Page');
const searchAudiences = suppliedSearchAudiences
  ?? (pathname.startsWith('/showcase') ? ['Trainees', 'Trainers', 'Leaders']
    : pathname.startsWith('/imaging-lab') ? ['Trainers', 'Leaders']
    : ['Trainees']);
const searchTopics = suppliedSearchTopics
  ?? (pathname.startsWith('/showcase') ? ['Stones', 'Innovation', 'Evidence']
    : pathname.startsWith('/imaging-lab') ? ['Imaging', 'Innovation']
    : pathname.startsWith('/last30days') ? ['Measurement', 'Governance']
    : pathname.startsWith('/deep-dives') ? ['Evidence']
    : pathname.startsWith('/app') ? ['Clinical reference']
    : ['Urology']);

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'UroRef',
  url: (Astro.site ?? Astro.url).toString().replace(/\/$/, ''),
  logo: new URL('/icon-512.png', Astro.site ?? Astro.url).toString(),
  description,
  sameAs: [],
};

const siteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'UroRef',
  url: (Astro.site ?? Astro.url).toString().replace(/\/$/, ''),
  description,
};
---
<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="uroref-build-ref" content={buildRef} />
  <title>{title} | UroRef</title>
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate icon" href="/favicon.ico" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#0A2540" />
  <meta data-pagefind-meta="site[content]" content="UroRef" />
  <meta data-pagefind-meta="contentType[content]" content={searchContentType} />
  {searchAudiences.map((audience) => <meta data-pagefind-filter="audience[content]" content={audience} />)}
  {searchTopics.map((topic) => <meta data-pagefind-filter="topic[content]" content={topic} />)}
  <meta data-pagefind-filter="contentType[content]" content={searchContentType} />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="UroRef" />
  <meta property="og:title" content={`${title} | UroRef`} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${title} | UroRef`} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;0,8..60,600;1,8..60,400&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  <Analytics />
</head>
<body>

  <a class="skip-link" href="#main-content">Skip to main content</a>

  <!-- Nav -->
  <header class="site-nav">
    <div class="site-nav-inner">
      <a href="/" class="u-wordmark" style="font-size: 22px;" aria-label="UroRef home">
        <span class="uro">Uro</span><span class="ref">Ref</span>
        <span class="dot" style="width: 4px; height: 4px; margin-bottom: 1px;"></span>
      </a>

      <nav class="site-nav-links" aria-label="Primary">
        <a href="/showcase" class:list={{ on: isActive('/showcase') }} aria-current={isActive('/showcase') ? 'page' : undefined}>Mega Hub</a>
        <a href="/deep-dives" class:list={{ on: isActive('/deep-dives') }} aria-current={isActive('/deep-dives') ? 'page' : undefined}>Deep Dives</a>
        <a href="/about" class:list={{ on: isActive('/about') }} aria-current={isActive('/about') ? 'page' : undefined}>About</a>
        <a href="/contact" class:list={{ on: isActive('/contact') }} aria-current={isActive('/contact') ? 'page' : undefined}>Contact</a>
        <a href="/app" class:list={{ 'site-nav-app': true, on: isActive('/app') }} aria-current={isActive('/app') ? 'page' : undefined}>Get the app</a>
      </nav>

      <div class="site-nav-actions">
        <HubSearch />
        <button type="button" class="site-nav-burger" aria-label="Open menu" aria-expanded="false" aria-controls="site-nav-drawer" data-site-menu-button>
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>

    <nav id="site-nav-drawer" class="site-nav-drawer" aria-label="Mobile" data-site-menu hidden>
      <a href="/showcase">Mega Hub</a>
      <a href="/deep-dives">Deep Dives</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
      <a href="/app" class="drawer-app">Get the app</a>
    </nav>
  </header>

  <main id="main-content" tabindex="-1">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="site-footer-inner">
      <div class="site-footer-top">
        <div class="about">
          <span class="u-wordmark" style="font-size: 22px;">
            <span class="uro">Uro</span><span class="ref">Ref</span>
            <span class="dot" style="width: 4px; height: 4px; margin-bottom: 1px;"></span>
          </span>
          <p>A weekly urology training publication. Written by Nity G, ST5 Urology Registrar, North West Deanery.</p>
          <p class="site-footer-email"><a href="mailto:nity@uroref.com">nity@uroref.com</a></p>
        </div>
        <div>
          <h4>Read</h4>
          <ul>
            <li><a href="/showcase">Mega Hub</a></li>
            <li><a href="/deep-dives">Deep Dives</a></li>
            <li><a href="https://forms.gle/4QTK3MSgMsedJQEw7" target="_blank" rel="noopener">Newsletter</a></li>
          </ul>
        </div>
        <div>
          <h4>Product</h4>
          <ul>
            <li><a href="/app">iOS app</a></li>
            <li><a href="/app">Android app</a></li>
            <li><a href="/imaging-lab">Imaging lab</a></li>
            <li><a href="/updates">Changelog</a></li>
          </ul>
        </div>
        <div>
          <h4>About</h4>
          <ul>
            <li><a href="/about">The author</a></li>
            <li><a href="/contact">Contact</a></li>
            <li><a href="/privacy">Privacy</a></li>
            <li><a href="/terms">Terms</a></li>
          </ul>
        </div>
      </div>

      <div class="site-footer-disclaimer">
        <b>Medical disclaimer.</b> UroRef is an educational resource for healthcare professionals. It does not constitute medical advice. Always follow local guidelines and clinical judgement.
      </div>

      <div class="site-footer-legal">
        <div>
          <a href="/privacy">Privacy</a>
          <a href="/terms">Terms</a>
          <a href="/contact">Contact</a>
        </div>
      </div>
    </div>
  </footer>

  <footer class="ur-footer" role="contentinfo">
    <div class="ur-footer-inner">
      <p class="ur-footer-label">UROREF · THE UROREF PROJECT</p>
      <p class="ur-footer-name"><strong>Nityanandan G</strong> &nbsp;·&nbsp; <a href="mailto:nity@uroref.com">nity@uroref.com</a></p>
      <p class="ur-footer-small">&copy; 2026 Nityanandan G. All rights reserved. All content on this site, including its text, bullet points, logos, images and AI-generated imagery, drill cards, 3D models, and underlying code, is the work and property of Nityanandan G and may not be reproduced, copied, or used to train AI systems without prior written permission.</p>
      <p class="ur-footer-small">Content is provided for professional reference and education only and is not medical advice.</p>
    </div>
  </footer>

  <script>
    const setupSiteMenu = () => {
      const button = document.querySelector('[data-site-menu-button]');
      const menu = document.querySelector('[data-site-menu]');
      if (!(button instanceof HTMLButtonElement) || !(menu instanceof HTMLElement) || button.dataset.ready === 'true') return;
      button.dataset.ready = 'true';
      const setOpen = (open) => {
        button.setAttribute('aria-expanded', String(open));
        button.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        menu.hidden = !open;
        button.classList.toggle('is-open', open);
      };
      button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));
      menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setOpen(false)));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
          setOpen(false);
          button.focus();
        }
      });
    };
    setupSiteMenu();
    document.addEventListener('astro:page-load', setupSiteMenu);
  </script>

</body>
</html>

<style is:global>
  /* ══════════ Shared site nav + footer (v1) ══════════ */
  .site-nav {
    background: rgba(10, 37, 64, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .site-nav-inner {
    max-width: var(--container);
    margin: 0 auto;
    padding: 20px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }
  .site-nav-links {
    display: flex;
    gap: 28px;
    font-size: 14px;
    font-weight: 500;
    color: var(--text-secondary);
  }
  .site-nav-links a { transition: color 0.15s; }
  .site-nav-links a:hover, .site-nav-links a.on { color: var(--text-primary); }
  .site-nav-links a.site-nav-app { color: var(--teal-500); }
  .site-nav-links a.site-nav-app:hover { color: var(--teal-400); }

  .site-nav-actions { display: flex; align-items: center; gap: 10px; }

  .site-nav-burger {
    display: none;
    width: 40px; height: 40px;
    border-radius: var(--r-md);
    cursor: pointer;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    border: 1px solid var(--border-strong);
    background: transparent;
    transition: border-color 0.15s, background 0.15s;
  }
  .site-nav-burger:hover { border-color: var(--teal-500); }
  .site-nav-burger span {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--text-primary);
    border-radius: 2px;
    transition: transform 0.2s, opacity 0.2s;
  }

  /* Drawer */
  .site-nav-drawer {
    display: none;
    flex-direction: column;
    padding: 8px 20px 20px;
    background: rgba(10, 37, 64, 0.98);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-top: 1px solid var(--border);
  }
  .site-nav-drawer:not([hidden]) { display: flex; }
  .site-nav-drawer a {
    padding: 14px 4px;
    font-size: 16px;
    color: var(--text-secondary);
    border-bottom: 1px solid var(--border);
    transition: color 0.15s;
  }
  .site-nav-drawer a:hover { color: var(--text-primary); }
  .site-nav-drawer a.drawer-app { color: var(--teal-500); }
  .site-nav-drawer a.drawer-app:hover { color: var(--teal-400); }

  .site-nav-burger.is-open span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .site-nav-burger.is-open span:nth-child(2) {
    opacity: 0;
  }
  .site-nav-burger.is-open span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 820px) {
    .site-nav-inner { padding: 16px 20px; gap: 16px; }
    .site-nav-links { display: none; }
    .site-nav-burger { display: flex; }
  }

  .site-footer {
    padding: 64px 32px 40px;
    color: var(--text-muted);
    font-size: 13px;
    border-top: 1px solid var(--border);
    margin-top: 96px;
  }
  .site-footer-inner { max-width: var(--container); margin: 0 auto; }
  .site-footer-top {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1fr;
    gap: 48px;
    margin-bottom: 48px;
  }
  .site-footer-top h4 {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin: 0 0 14px 0;
  }
  .site-footer-top ul { list-style: none; padding: 0; margin: 0; }
  .site-footer-top li { margin-bottom: 8px; }
  .site-footer-top li a { color: var(--text-secondary); font-size: 14px; transition: color 0.15s; }
  .site-footer-top li a:hover { color: var(--text-primary); }
  .site-footer-top .about p {
    font-family: var(--font-serif);
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.55;
    max-width: 34ch;
    margin: 12px 0 0 0;
  }
  .site-footer-top .about .site-footer-email {
    font-family: var(--font-mono);
    font-size: 12px;
    margin-top: 10px;
  }
  .site-footer-top .about .site-footer-email a {
    color: var(--teal-500);
    transition: color 0.15s;
  }
  .site-footer-top .about .site-footer-email a:hover { color: var(--teal-400); }
  .site-footer-disclaimer {
    padding: 20px 24px;
    background: var(--navy-900);
    border: 1px solid var(--border);
    border-radius: var(--r-lg);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 32px;
  }
  .site-footer-disclaimer b { color: var(--text-secondary); font-weight: 500; }
  .site-footer-legal {
    display: flex;
    justify-content: space-between;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 11px;
    flex-wrap: wrap;
    gap: 12px;
  }
  .site-footer-legal a { margin-left: 20px; transition: color 0.15s; }
  .site-footer-legal a:hover { color: var(--text-primary); }

  @media (max-width: 820px) {
    .site-footer-top { grid-template-columns: 1fr 1fr; gap: 32px; }
    .site-footer-top .about { grid-column: 1 / -1; }
    .site-footer-legal a { margin-left: 14px; }
    .site-footer { padding: 48px 20px 32px; }
  }

  /* Shared legal footer */
  .ur-footer{background:transparent;color:inherit;font-family:inherit;text-align:center;padding:34px 20px 30px;border-top:1px solid rgba(128,128,128,.28);border-top:1px solid color-mix(in srgb, currentColor 22%, transparent)}
  .ur-footer *{margin:0;padding:0;box-sizing:border-box}
  .ur-footer-inner{max-width:680px;margin:0 auto;display:grid;gap:9px}
  .ur-footer a{color:inherit;text-decoration:underline;text-underline-offset:2px}
  .ur-footer a:hover{text-decoration-thickness:2px}
  .ur-footer a:focus-visible{outline:2px solid currentColor;outline-offset:2px}
  .ur-footer-label{font-size:10px;font-weight:600;letter-spacing:.24em;opacity:.5}
  .ur-footer-name{font-size:15px;opacity:.88}
  .ur-footer-name strong{font-weight:600}
  .ur-footer-name a{font-weight:500}
  .ur-footer-small{font-size:11.5px;line-height:1.7;opacity:.55}
</style>
