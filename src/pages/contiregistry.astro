---
import Base from '../layouts/Base.astro';

// Unlisted product page: noindex, left out of the sitemap and not linked from the site.
const DEMO = 'mailto:nity@uroref.com?subject=ContiRegistry%20demo';

const steps = [
  {
    n: '01', when: 'At admission', title: 'Snap the sticker.',
    body: 'The optional AI Builder reader fills the name, NHS number, hospital number and date of birth from a photo of the patient’s sticker.',
    img: '/contiregistry/img/g-sticker.jpg', alt: 'A phone photographing a fictional patient sticker beside the patient identity form, with the fields filled in.',
  },
  {
    n: '02', when: 'In theatre', title: 'Scan every box.',
    body: 'Point the camera at the Rigicon ContiClassic component packaging. Each GS1 code fills the product code, lot, serial number and expiry date. No hunting for serial numbers, no copying them by hand.',
    img: '/contiregistry/img/g-scan.jpg', alt: 'A demonstration component label for an occlusive cuff being read by a scanning line across its GS1 DataMatrix code.',
  },
  {
    n: '03', when: 'At home', title: 'One scan. Ten questions. One tap to send.',
    body: 'The app drafts a letter with the site’s QR code and the patient’s check-in code. The patient answers on their own phone, and the answers link to the record. No re-keying.',
    img: '/contiregistry/img/g-phone.jpg', alt: 'A phone showing the submitted check-in form, with steps reading letter or email arrives, patient scans and answers.',
  },
  {
    n: '04', when: 'In audit', title: 'Ask your data anything.',
    body: 'Revisions, explants, device survival and patient-reported change, with counts and denominators, ready for an audit, a meeting or a poster. Export a site pack, or the MDOR extract for NHS England, in one click.',
    img: '/contiregistry/img/g-metrics.jpg', alt: 'An example three-dimensional chart of cuff sizes used, built from a typed question. Illustrative values.',
  },
];

// The closed loop: one next step at a time, in this order (ContiRegistry 2.5).
const loop = ['Follow-up due', 'Review requested', 'Responsibility accepted', 'Plan agreed', 'Action completed', 'Closure verified'];

const shots = [
  { img: '/contiregistry/img/g-record.jpg', title: 'The device record and its lifecycle', alt: 'A demonstration device record for a fictional patient, with the device lifecycle from implantation through review, activation, PROM and surveillance, and the next step with its responsible team.' },
  { img: '/contiregistry/img/g-owner.jpg', title: 'A named owner, or plainly Awaiting owner', alt: 'Two demonstration next steps: a 6-week activation accepted by the Continence CNS Team, and a 12-month follow-up shown as overdue by 24 days and awaiting owner, viewed twice and still open.' },
  { img: '/contiregistry/img/g-awaiting.jpg', title: 'Action completed, awaiting closure', alt: 'The demonstration 12-month follow-up after the action was completed, still marked awaiting closure, with a Verify closure button.' },
  { img: '/contiregistry/img/g-closed.jpg', title: 'Closure verified', alt: 'The demonstration 12-month follow-up with closure verified by the continence lead, every lifecycle stage complete.' },
];

const strengths = [
  { t: 'Named clinical ownership', d: 'Every next step shows a responsible clinician or team, or says plainly that it is awaiting an owner.' },
  { t: 'Overdue follow-up, kept in view', d: 'Due soon, overdue and significantly overdue are shown in stages, and stay on screen until the step is done.' },
  { t: 'Implant lifecycle history', d: 'Implantation, activation, reviews, revisions and every next step on one timeline for each device episode.' },
  { t: 'PROMs', d: 'Patient-reported outcomes from the check-in form sit on the same timeline as the clinic reviews.' },
  { t: 'Longitudinal outcomes', d: 'Device survival, revisions and patient-reported change over time, with counts and denominators.' },
  { t: 'Audit trail', d: 'Who did what, and when: created, assigned, accepted, reassigned, plan changed, completed, verified, reopened, escalated.' },
  { t: 'Verified closure', d: 'Completing an action and closing it are separate steps. Closure is verified by a site owner, with the evidence noted.' },
  { t: 'Future interoperability', d: 'Designed around established healthcare workflow principles with future FHIR and NHS interoperability in mind.' },
  { t: 'Governance and QI', d: 'Built for audit, service evaluation and quality improvement. It records who agreed to do what; it does not make clinical decisions.' },
];

// What each question in the dataset is based on. Questionnaire items are not reproduced here.
const measures = [
  { area: 'Continence symptoms and their impact', name: 'ICIQ-UI Short Form', what: 'How often and how much urine leaks, and how much this interferes with daily life. Scored 0 to 21.', when: 'Before surgery and at every review, including from home', who: 'Patient', kind: 'Validated questionnaire', ref: 'Avery K et al. Neurourol Urodyn 2004;23:322–30' },
  { area: 'Leakage, measured', name: '24-hour pad count and pad weight', what: 'Pads used in 24 hours, and their weight where measured. Social continence is 0 or 1 pad a day.', when: 'Before surgery and at reviews', who: 'Patient and team', kind: 'Standard outcome measure', ref: 'Nitti VW et al. J Urol 2014;192:836–42' },
  { area: 'Change since the operation', name: 'PGI-I, with PGI-S at baseline', what: 'The patient’s own rating of change, from very much better to very much worse, and of severity before surgery.', when: 'PGI-S before surgery, PGI-I at reviews', who: 'Patient', kind: 'Validated questionnaire', ref: 'Yalcin I, Bump RC. Am J Obstet Gynecol 2003;189:98–101' },
  { area: 'Health-related quality of life', name: 'EQ-5D-5L and EQ VAS', what: 'Five dimensions of general health, and a 0 to 100 rating of health on the day.', when: 'Before surgery and at 12 months', who: 'Patient', kind: 'Validated questionnaire', ref: 'Herdman M et al. Qual Life Res 2011;20:1727–36' },
  { area: 'Urinary symptoms before surgery', name: 'IPSS', what: 'Lower urinary tract symptoms, scored 0 to 35.', when: 'Before surgery', who: 'Patient', kind: 'Validated questionnaire', ref: 'Barry MJ et al. J Urol 1992;148:1549–57' },
  { area: 'Erectile function before surgery', name: 'IIEF-5', what: 'Erectile function, scored 5 to 25, where relevant.', when: 'Before surgery', who: 'Patient', kind: 'Validated questionnaire', ref: 'Rosen RC et al. Int J Impot Res 1999;11:319–26' },
  { area: 'Complications', name: 'Clavien–Dindo grade', what: 'The severity of complications in hospital and in the early weeks after surgery.', when: 'After surgery', who: 'Team', kind: 'Recognised classification', ref: 'Dindo D, Demartines N, Clavien PA. Ann Surg 2004;240:205–13' },
  { area: 'Device identity', name: 'GS1 barcode data', what: 'GTIN, lot, serial number and expiry, read from the component packaging.', when: 'At implant and at revision', who: 'Scanned by the team', kind: 'International standard', ref: 'GS1 General Specifications' },
  { area: 'Device function and experience', name: 'ContiRegistry review items', what: 'Satisfaction, whether the patient would have the operation again, pump use, device status, cycling, pump position and the reason for any revision.', when: 'At reviews and at revision', who: 'Patient and team', kind: 'Registry-specific item', ref: 'Agreed with the clinical advisor. Not a validated scale.' },
];

const people = [
  {
    who: 'Surgeons',
    line: 'Operation details in a tap, every component scanned, and outcomes you can present: revisions, explants, device survival and how patients rate the change.',
  },
  {
    who: 'Specialist nurses',
    line: 'Overdue and missed reviews at a glance. Opening a record fills the review date, type and timepoint, and the app drafts the patient letter with its QR and check-in codes.',
  },
  {
    who: 'Trusts',
    line: 'Runs in the Trust’s own Microsoft 365: Power Apps, SharePoint, Forms and Outlook. Local permissions, records stay with the Trust, and a named colleague decides what, if anything, is shared.',
  },
];
---
<Base
  title="ContiRegistry: Follow the implant"
  description="ContiRegistry tracks the whole AUS device journey for ContiClassic, from implantation through follow-up, PROMs, review, revision and verified closure."
  image="/contiregistry/img/og.jpg"
  noindex={true}
>
  <div class="cr">

    <!-- Hero -->
    <section class="cr-hero" aria-labelledby="cr-title">
      <video class="cr-hero-video" autoplay muted loop playsinline preload="auto" poster="/contiregistry/img/hero-waves.jpg" aria-hidden="true" tabindex="-1" data-cr-bg>
        <source src="/contiregistry/media/hero-waves.mp4" type="video/mp4" />
      </video>
      <div class="cr-hero-shade" aria-hidden="true"></div>

      <button type="button" class="cr-sound" aria-pressed="false" data-cr-sound>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4V5z"/><path class="cr-sound-on" d="M15.5 8.5a5 5 0 0 1 0 7M19 5a10 10 0 0 1 0 14"/><path class="cr-sound-off" d="m22 9-6 6M16 9l6 6"/></svg>
        <span data-cr-sound-label>Sound off</span>
      </button>

      <div class="cr-hero-inner">
        <img class="cr-mark cr-rise" style="--d: 0s" src="/contiregistry/img/contiregistry-mark.svg" width="72" height="72" alt="" />
        <p class="cr-eyebrow cr-rise" style="--d: .1s">The AUS device register for ContiClassic<sup class="tm">™</sup></p>
        <h1 id="cr-title" class="cr-brand">
          <span class="cr-brand-main cr-rise" style="--d: .25s"><span class="cr-brand-name"><b>Conti</b>Registry</span>: Follow the implant</span>
          <span class="cr-brand-sub cr-rise" style="--d: .45s">not just the implantation</span>
        </h1>
        <p class="cr-lead cr-rise" style="--d: .65s">ContiRegistry tracks the whole device journey, from implantation through follow-up, PROMs, review, revision and verified closure.</p>
        <ul class="cr-know cr-rise" style="--d: .8s">
          <li>Know what needs to happen next.</li>
          <li>Know who owns it.</li>
          <li>Know whether it was actually completed.</li>
        </ul>
        <div class="cr-cta cr-rise" style="--d: .95s">
          <a class="cr-btn cr-btn-primary" href="#film">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
            Watch the film
          </a>
          <a class="cr-btn cr-btn-ghost" href={DEMO}>Request a demo</a>
        </div>
      </div>

      <a class="cr-scroll" href="#film" aria-label="Scroll to the film"><span></span></a>
    </section>

    <!-- Film -->
    <section id="film" class="cr-section cr-film" aria-labelledby="cr-film-title">
      <div class="cr-wrap">
        <p class="cr-kicker cr-reveal">The film</p>
        <h2 id="cr-film-title" class="cr-h2 cr-reveal">From theatre to verified closure, in under six minutes.</h2>
        <div class="cr-player cr-reveal">
          <video controls playsinline preload="metadata" poster="/contiregistry/img/poster.jpg" aria-label="ContiRegistry film, 5 minutes 44 seconds, narrated with captions" data-cr-film>
            <source src="/contiregistry/media/contiregistry-film.mp4" type="video/mp4" />
            Your browser cannot play this video. <a href="/contiregistry/media/contiregistry-film.mp4">Download the film (MP4)</a>.
          </video>
        </div>
        <p class="cr-soundnote cr-reveal">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5 6 9H2v6h4l5 4V5z"/><path d="M15.5 8.5a5 5 0 0 1 0 7M19 5a10 10 0 0 1 0 14"/></svg>
          <span><b>Turn your sound on.</b> The film is narrated, with captions on screen.</span>
        </p>
      </div>
    </section>

    <!-- Closed loop (release 2.5) -->
    <section class="cr-section cr-loop" aria-labelledby="cr-loop-title">
      <div class="cr-wrap">
        <p class="cr-kicker cr-reveal">Coming in ContiRegistry 2.5</p>
        <h2 id="cr-loop-title" class="cr-h2 cr-reveal">Closed-loop device lifecycle management</h2>
        <ol class="cr-flow cr-reveal" aria-label="The closed loop, one step at a time">
          {loop.map((s, i) => (
            <li class:list={['cr-flow-step', { last: i === loop.length - 1 }]}>
              <span class="cr-flow-n" aria-hidden="true">{i === loop.length - 1 ? '✓' : i + 1}</span>
              <span class="cr-flow-t">{s}</span>
            </li>
          ))}
        </ol>
        <p class="cr-loop-lead cr-reveal">A viewed alert is not a completed clinical action. ContiRegistry keeps outstanding actions visible until the required next step has genuinely been completed.</p>
        <ul class="cr-rules cr-reveal" aria-label="Three rules the app keeps">
          <li>Viewed <span aria-hidden="true">≠</span><span class="sr-only">is not</span> completed</li>
          <li>Accepted <span aria-hidden="true">≠</span><span class="sr-only">is not</span> completed</li>
          <li>Completed <span aria-hidden="true">≠</span><span class="sr-only">is not</span> closure verified</li>
        </ul>
        <ul class="cr-shots">
          {shots.map((s) => (
            <li class="cr-reveal">
              <figure class="cr-shot">
                <img src={s.img} alt={s.alt} width="1280" height="720" loading="lazy" decoding="async" />
                <figcaption>{s.title}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
        <ul class="cr-strengths">
          {strengths.map((s) => (
            <li class="cr-reveal">
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </li>
          ))}
        </ul>
        <p class="cr-loop-note cr-reveal">Release 2.5 has been built and is being tested with demonstration data. It is not yet live at any site. Screens shown use fictional records.</p>
      </div>
    </section>

    <!-- Guide -->
    <section class="cr-section cr-guide" aria-labelledby="cr-guide-title">
      <div class="cr-wrap">
        <p class="cr-kicker cr-reveal">How it works</p>
        <h2 id="cr-guide-title" class="cr-h2 cr-reveal">Four moments. One record.</h2>
        <ol class="cr-steps">
          {steps.map((s, i) => (
            <li class:list={['cr-step', 'cr-reveal', { flip: i % 2 === 1 }]} data-cr-whoosh>
              <figure class="cr-shot">
                <img src={s.img} alt={s.alt} width="1280" height="720" loading="lazy" decoding="async" />
              </figure>
              <div class="cr-step-text">
                <p class="cr-step-n"><span>{s.n}</span>{s.when}</p>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Dataset sources -->
    <section class="cr-section cr-data" aria-labelledby="cr-data-title">
      <div class="cr-wrap">
        <p class="cr-kicker cr-reveal">The dataset</p>
        <h2 id="cr-data-title" class="cr-h2 cr-reveal">Every question has a source.</h2>
        <p class="cr-data-lead cr-reveal">The questions patients answer, and the measures the team records, come from published, validated questionnaires and recognised classifications. The few that are specific to ContiRegistry are marked as such.</p>
        <div class="cr-review cr-reveal">
          <p class="cr-review-k">Clinical review</p>
          <p>Every question in the dataset, including the patient check-in form, has been reviewed by our clinical advisor, <strong>Mr Andrew Baird</strong>, Consultant Urologist, Royal Liverpool University Hospital.</p>
        </div>
        <ul class="cr-measures">
          {measures.map((m) => (
            <li class:list={['cr-reveal', { own: m.kind === 'Registry-specific item' }]}>
              <p class="cr-m-area">{m.area}</p>
              <h3>{m.name}</h3>
              <p class="cr-m-what">{m.what}</p>
              <dl>
                <div><dt>When</dt><dd>{m.when}</dd></div>
                <div><dt>Completed by</dt><dd>{m.who}</dd></div>
                <div><dt>Basis</dt><dd><span class="cr-m-kind">{m.kind}</span> {m.ref}</dd></div>
              </dl>
            </li>
          ))}
        </ul>
        <p class="cr-data-note cr-reveal">Questionnaire items are not reproduced on this page. ICIQ-UI SF is copyright of ICIQ, and EQ-5D is a trade mark of the EuroQol Research Foundation; use of both is subject to registration with their owners.</p>
      </div>
    </section>

    <!-- Who it is for -->
    <section class="cr-section cr-who" aria-labelledby="cr-who-title">
      <div class="cr-wrap">
        <p class="cr-kicker cr-reveal">Who it is for</p>
        <h2 id="cr-who-title" class="cr-h2 cr-reveal">Built for everyone in the pathway.</h2>
        <ul class="cr-cards">
          {people.map((p) => (
            <li class="cr-card cr-reveal">
              <h3>{p.who}</h3>
              <p>{p.line}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Demo -->
    <section class="cr-section cr-demo" aria-labelledby="cr-demo-title">
      <div class="cr-wrap cr-demo-inner cr-reveal">
        <img src="/contiregistry/img/contiregistry-mark.svg" width="64" height="64" alt="" />
        <h2 id="cr-demo-title" class="cr-h2">See it on your own pathway.</h2>
        <p>We will walk your team through ContiRegistry using demonstration data.</p>
        <a class="cr-btn cr-btn-primary" href={DEMO}>Request a demo</a>
        <p class="cr-mail"><a href="mailto:nity@uroref.com">nity@uroref.com</a></p>
      </div>
    </section>

    <!-- Credits and notes -->
    <section class="cr-notes" aria-label="Credits and notes">
      <div class="cr-wrap">
        <p><b>ContiRegistry<sup class="tm">™</sup></b> is a product of UroRef Ltd. Created by Nity G, Urology Registrar. Clinical advisor: Mr Andrew Baird, Consultant Urologist, Royal Liverpool University Hospital.</p>
        <p>The film and screenshots use demonstration data: patient details are fictional, chart values are illustrative and the second site (Wirral) is illustrative. ContiRegistry supports data collection and audit by clinical teams; it does not give clinical advice. Naming an NHS organisation does not imply its endorsement. Rigicon and ContiClassic are trademarks of their respective owner.</p>
      </div>
    </section>

  </div>

  <audio preload="none" loop data-cr-ambient><source src="/contiregistry/media/ambient.mp3" type="audio/mpeg" /></audio>
  <audio preload="none" data-cr-whoosh-audio><source src="/contiregistry/media/whoosh.mp3" type="audio/mpeg" /></audio>

  <script>
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const bg = document.querySelector('[data-cr-bg]');
    if (bg instanceof HTMLVideoElement && reduce) { bg.pause(); bg.removeAttribute('autoplay'); }

    // optional ambient sound (off by default); a soft whoosh as each step arrives, only while sound is on
    const btn = document.querySelector('[data-cr-sound]');
    const label = document.querySelector('[data-cr-sound-label]');
    const amb = document.querySelector('[data-cr-ambient]');
    const whoosh = document.querySelector('[data-cr-whoosh-audio]');
    const film = document.querySelector('[data-cr-film]');
    let soundOn = false;
    const setSound = (on) => {
      soundOn = on;
      if (btn) btn.setAttribute('aria-pressed', String(on));
      if (label) label.textContent = on ? 'Sound on' : 'Sound off';
      if (amb instanceof HTMLAudioElement) {
        if (on) { amb.volume = 0.35; amb.play().catch(() => setSound(false)); } else amb.pause();
      }
    };
    btn?.addEventListener('click', () => setSound(!soundOn));
    film?.addEventListener('play', () => { if (soundOn) setSound(false); });

    // reveal on scroll
    const items = document.querySelectorAll('.cr-reveal');
    if (reduce || !('IntersectionObserver' in window)) {
      items.forEach((el) => el.classList.add('in'));
    } else {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.add('in');
          if (soundOn && e.target.hasAttribute('data-cr-whoosh') && whoosh instanceof HTMLAudioElement) {
            whoosh.currentTime = 0; whoosh.volume = 0.5; whoosh.play().catch(() => {});
          }
          io.unobserve(e.target);
        });
      }, { threshold: 0.18, rootMargin: '0px 0px -8% 0px' });
      items.forEach((el) => io.observe(el));
    }
  </script>
</Base>

<style>
  @font-face { font-family: 'Lenia Sans'; src: url('/contiregistry/fonts/lenia-sans-light.woff2') format('woff2'); font-weight: 300; font-display: swap; }
  @font-face { font-family: 'Lenia Sans'; src: url('/contiregistry/fonts/lenia-sans-regular.woff2') format('woff2'); font-weight: 400; font-display: swap; }
  @font-face { font-family: 'Lenia Sans'; src: url('/contiregistry/fonts/lenia-sans-medium.woff2') format('woff2'); font-weight: 500; font-display: swap; }
  @font-face { font-family: 'Lenia Sans'; src: url('/contiregistry/fonts/lenia-sans-semibold.woff2') format('woff2'); font-weight: 600; font-display: swap; }
  @font-face { font-family: 'Lenia Sans'; src: url('/contiregistry/fonts/lenia-sans-bold.woff2') format('woff2'); font-weight: 700; font-display: swap; }
  @font-face { font-family: 'Lenia Sans'; src: url('/contiregistry/fonts/lenia-sans-extrabold.woff2') format('woff2'); font-weight: 800; font-display: swap; }

  .cr {
    --cr-bg: #03070b;
    --cr-navy: #0b1a26;
    --cr-teal: #2fe0d0;
    --cr-grad: linear-gradient(90deg, #7df7ec, #22d3c5);
    --cr-gold: linear-gradient(90deg, #f6d58a, #e0a63a);
    --cr-text: #ffffff;
    --cr-soft: rgba(255, 255, 255, 0.74);
    --cr-faint: rgba(255, 255, 255, 0.5);
    --cr-line: rgba(255, 255, 255, 0.1);
    background: var(--cr-bg);
    color: var(--cr-text);
    font-family: 'Lenia Sans', var(--font-sans);
    overflow-x: clip;
  }
  .cr-wrap { max-width: 1120px; margin: 0 auto; padding: 0 24px; }
  .cr-teal { background: var(--cr-grad); -webkit-background-clip: text; background-clip: text; color: transparent; }

  /* hero */
  .cr-hero {
    position: relative; min-height: calc(100svh - 72px); display: grid; place-items: center;
    padding: 96px 24px 120px; isolation: isolate; overflow: hidden; text-align: center;
  }
  .cr-hero-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; filter: saturate(1.1) brightness(.75); }
  .cr-hero-shade { position: absolute; inset: 0; z-index: -1; background:
    radial-gradient(ellipse at 50% 45%, rgba(3, 7, 11, .25) 0%, rgba(3, 7, 11, .7) 62%, rgba(3, 7, 11, .95) 100%),
    linear-gradient(180deg, rgba(3, 7, 11, .2) 0%, rgba(3, 7, 11, 0) 40%, var(--cr-bg) 100%); }
  .cr-hero-inner { max-width: 980px; }
  .cr-mark { width: clamp(56px, 6vw, 72px); height: auto; margin: 0 auto 22px; display: block; filter: drop-shadow(0 0 24px rgba(47, 224, 208, .35)); }
  .tm { font-family: var(--font-sans); font-weight: 500; font-size: .6em; vertical-align: super; line-height: 0; margin-left: .05em; }
  .cr-eyebrow { font-size: clamp(1rem, 1.6vw, 1.2rem); font-weight: 500; color: var(--cr-soft); margin: 0 0 22px; }
  .cr-brand { margin: 0; display: grid; gap: clamp(8px, 1.4vw, 16px); justify-items: center; }
  .cr-brand-main { display: block; font-weight: 800; font-size: clamp(2.3rem, 6.4vw, 5.2rem); line-height: 1.02; letter-spacing: -0.035em; color: var(--cr-text); text-wrap: balance; }
  .cr-brand-name { font-weight: 300; color: var(--cr-soft); }
  .cr-brand-name b { font-weight: 800; color: var(--cr-text); }
  .cr-brand-sub { display: block; font-weight: 500; font-size: clamp(1.35rem, 3.2vw, 2.4rem); line-height: 1.15; letter-spacing: -0.015em; background: var(--cr-gold); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .cr-lead { margin: clamp(26px, 3.4vw, 38px) auto 0; max-width: 46ch; font-size: clamp(1.1rem, 1.9vw, 1.4rem); line-height: 1.5; color: var(--cr-text); font-weight: 500; text-wrap: balance; }
  .cr-know { list-style: none; margin: 22px 0 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 22px; color: var(--cr-soft); font-size: clamp(1rem, 1.6vw, 1.15rem); }
  .cr-know li { display: inline-flex; align-items: center; gap: 10px; }
