---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { CONTENT_VERSION, LINK_CHECKED_LABEL, ecosystemProjects } from '../data/ecosystem';

const allDeepDives = await getCollection('deep-dives');
const formatter = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

const datedDives = allDeepDives
  .map((article) => ({ article, date: new Date(article.data.date) }))
  .filter(({ date }) => !Number.isNaN(date.valueOf()))
  .sort((a, b) => b.date.valueOf() - a.date.valueOf());

const latestDive = datedDives[0];
const currentSignals = [
  { value: ecosystemProjects.length, label: 'connected public projects', detail: 'Counted from the shared project register' },
  { value: allDeepDives.length, label: 'published Deep Dives', detail: 'Counted from the current site build' },
  { value: '2', label: 'installable app platforms', detail: 'iOS and Android' },
  { value: '0', label: 'invented usage metrics', detail: 'No audience figures shown without a real source' },
];

const pilotMeasures = [
  { measure: 'Time to source', question: 'Can a trainee reach the relevant original guidance quickly?', method: 'Observed, timed tasks using pre-agreed clinical learning scenarios.', status: 'Pilot measure' },
  { measure: 'Task completion', question: 'Can the learner complete the intended education task without facilitator rescue?', method: 'Binary completion plus short structured observation notes.', status: 'Pilot measure' },
  { measure: 'Source freshness', question: 'Are links live, dates visible and summaries still bounded by the source?', method: 'Scheduled link check and named content-owner review.', status: 'Build evidence' },
  { measure: 'Accessibility', question: 'Can the core journey be completed with keyboard, zoom and assistive technology?', method: 'axe-core checks followed by manual keyboard, contrast and 200% zoom review.', status: 'Build evidence' },
  { measure: 'Safety defects', question: 'Does any card overstate evidence, hide a boundary or imply patient-specific advice?', method: 'Claims register, reviewer sign-off and severity-tagged defect log.', status: 'Pilot measure' },
  { measure: 'Acceptability', question: 'Would trainees, trainers and patients use or recommend this learning format?', method: 'Short post-task survey, reported with sample size and question wording.', status: 'Pilot measure' },
];
---

<Base
  title="Impact and freshness — measured without theatre"
  description="UroRef's transparent measurement framework: current build facts, source freshness and proposed 90-day pilot outcomes."
>
  <section class="impact-hero">
    <div class="impact-glow" aria-hidden="true"></div>
    <div class="impact-wrap">
      <p class="u-eyebrow-pill">Transparent impact framework</p>
      <h1>Measure what matters.<br /><span class="u-gradient-text">Publish what is real.</span></h1>
      <p class="impact-lede">This page deliberately contains no simulated readership, engagement or outcome figures. It separates facts available from the current build from measures that need a properly governed pilot.</p>
      <div class="impact-stamps" aria-label="Build status">
        <span>Content version {CONTENT_VERSION}</span>
        <span>{LINK_CHECKED_LABEL}</span>
        <span>Education only</span>
      </div>
      <div class="impact-actions">
        <a class="impact-primary" href="/showcase#pilot">See the 90-day proposal <span aria-hidden="true">→</span></a>
        <a class="impact-secondary" href="/showcase#evidence-desk">Open the evidence desk</a>
      </div>
    </div>
  </section>

  <section class="impact-section impact-snapshot" aria-labelledby="snapshot-title">
    <div class="impact-wrap">
      <div class="impact-heading">
        <div>
          <p class="impact-kicker">Current snapshot</p>
          <h2 id="snapshot-title">Facts generated from this build</h2>
        </div>
        <p>Counts update only when the underlying project register or publication collection changes.</p>
      </div>
      <div class="signal-grid">
        {currentSignals.map((signal) => (
          <article class="signal-card">
            <strong>{signal.value}</strong>
            <h3>{signal.label}</h3>
            <p>{signal.detail}</p>
          </article>
        ))}
      </div>
      {latestDive && (
        <p class="latest-note">
          Latest dated publication: <a href={`/deep-dives/${latestDive.article.id}`}>{latestDive.article.data.title}</a>
          <span> · {formatter.format(latestDive.date)}</span>
        </p>
      )}
    </div>
  </section>

  <section class="impact-section impact-dark" aria-labelledby="measurement-title">
    <div class="impact-wrap">
      <div class="impact-heading">
        <div>
          <p class="impact-kicker">Proposed pilot scorecard</p>
          <h2 id="measurement-title">Six outcomes, agreed before collection</h2>
        </div>
        <p>No proxy will be presented as clinical benefit, competence or improved patient outcome.</p>
      </div>
      <div class="measure-list">
        {pilotMeasures.map((item, index) => (
          <article class="measure-row">
            <div class="measure-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</div>
            <div class="measure-copy">
              <div class="measure-title-line">
                <h3>{item.measure}</h3>
                <span>{item.status}</span>
              </div>
              <p class="measure-question">{item.question}</p>
              <p class="measure-method"><strong>Method:</strong> {item.method}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="impact-section impact-principles" aria-labelledby="principles-title">
    <div class="impact-wrap principles-grid">
      <div>
        <p class="impact-kicker">Reporting contract</p>
        <h2 id="principles-title">Every number keeps its context.</h2>
      </div>
      <div class="principle-cards">
        <article><span aria-hidden="true">01</span><h3>Show the denominator</h3><p>Every result carries its sample size, audience, dates and collection method.</p></article>
        <article><span aria-hidden="true">02</span><h3>Separate learning from outcomes</h3><p>Usability and confidence are not evidence of competence, safety or patient benefit.</p></article>
        <article><span aria-hidden="true">03</span><h3>Respect privacy</h3><p>Aggregate, privacy-first events only; no patient-identifiable data and no captured search text.</p></article>
        <article><span aria-hidden="true">04</span><h3>Report defects too</h3><p>Broken links, stale summaries, accessibility issues and unsafe claims belong in the result.</p></article>
      </div>
    </div>
  </section>

  <section class="impact-close">
    <div class="impact-wrap impact-close-inner">
      <div>
        <p class="impact-kicker">The honest baseline</p>
        <h2>There is no “live impact” claim today.</h2>
        <p>Umami is ready to be configured for privacy-first aggregate events after governance and consent choices are agreed. Until then, the site reports build facts—not pretend behaviour.</p>
      </div>
      <a href="/contact">Discuss measurement governance <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <style>
    .impact-wrap { width: min(1120px, calc(100% - 2.5rem)); margin-inline: auto; }
    .impact-hero { position: relative; overflow: hidden; padding: clamp(6rem, 11vw, 9rem) 0 5.5rem; color: #f4fbff; background: #03111f; isolation: isolate; }
    .impact-glow { position: absolute; inset: -30% 35% 20% -15%; z-index: -1; background: radial-gradient(circle, rgba(24, 211, 190, .25), transparent 65%); filter: blur(25px); }
    .impact-hero h1 { max-width: 850px; margin: 1.2rem 0; font-size: clamp(2.7rem, 7vw, 5.8rem); line-height: .95; letter-spacing: -.065em; }
    .impact-lede { max-width: 720px; color: rgba(232, 245, 251, .76); font-size: clamp(1.05rem, 2vw, 1.3rem); line-height: 1.7; }
    .impact-stamps { display: flex; flex-wrap: wrap; gap: .65rem; margin-top: 2rem; }
    .impact-stamps span { padding: .45rem .7rem; border: 1px solid rgba(137, 237, 224, .3); border-radius: 999px; color: #b8fff2; font: 700 .72rem/1.2 ui-monospace, monospace; letter-spacing: .06em; text-transform: uppercase; }
    .impact-actions { display: flex; flex-wrap: wrap; gap: .85rem; margin-top: 2.1rem; }
    .impact-actions a, .impact-close a { display: inline-flex; align-items: center; justify-content: center; gap: .65rem; min-height: 48px; padding: .8rem 1.1rem; border-radius: 12px; font-weight: 800; text-decoration: none; }
    .impact-primary { color: #021719; background: #5ff2df; }
    .impact-secondary { color: #eafcff; border: 1px solid rgba(255,255,255,.24); }
    .impact-section { padding: clamp(4.5rem, 8vw, 7rem) 0; }
    .impact-snapshot { background: #f3f8fa; color: #092134; }
    .impact-heading { display: flex; justify-content: space-between; align-items: end; gap: 2rem; margin-bottom: 2.3rem; }
    .impact-heading > p { max-width: 420px; margin: 0; color: #536b7a; line-height: 1.65; }
    .impact-kicker { margin: 0 0 .65rem; color: #006b65; font: 800 .75rem/1.2 ui-monospace, monospace; letter-spacing: .12em; text-transform: uppercase; }
    .impact-heading h2, .principles-grid h2, .impact-close h2 { margin: 0; font-size: clamp(2rem, 4vw, 3.25rem); line-height: 1.02; letter-spacing: -.045em; }
    .signal-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
    .signal-card { padding: 1.55rem; border: 1px solid #d4e2e6; border-radius: 18px; background: rgba(255,255,255,.8); box-shadow: 0 14px 35px rgba(4, 31, 48, .06); }
    .signal-card strong { display: block; color: #006f69; font-size: clamp(2.4rem, 5vw, 4.2rem); line-height: 1; letter-spacing: -.06em; }
    .signal-card h3 { margin: .8rem 0 .35rem; font-size: 1rem; }
    .signal-card p, .latest-note { margin: 0; color: #5a707e; font-size: .88rem; line-height: 1.55; }
    .latest-note { margin-top: 1.25rem; }
    .latest-note a { color: #006f69; font-weight: 800; }
    .impact-dark { color: #edfaff; background: #071827; }
    .impact-dark .impact-kicker { color: #66ebdc; }
    .impact-dark .impact-heading > p { color: rgba(226, 241, 247, .65); }
    .measure-list { border-top: 1px solid rgba(255,255,255,.14); }
    .measure-row { display: grid; grid-template-columns: 90px 1fr; gap: 1rem; padding: 1.7rem 0; border-bottom: 1px solid rgba(255,255,255,.14); }
    .measure-number { color: #61e9d9; font: 700 1rem/1 ui-monospace, monospace; }
    .measure-title-line { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .75rem; }
    .measure-title-line h3 { margin: 0; font-size: 1.25rem; }
    .measure-title-line span { color: #9cf8eb; font: 700 .68rem/1.2 ui-monospace, monospace; letter-spacing: .08em; text-transform: uppercase; }
    .measure-copy p { max-width: 780px; }
    .measure-question { margin: .55rem 0 .35rem; color: rgba(240, 250, 253, .88); }
    .measure-method { margin: 0; color: rgba(217, 235, 242, .6); font-size: .9rem; }
    .impact-principles { background: #fff; color: #0b2234; }
    .principles-grid { display: grid; grid-template-columns: .75fr 1.25fr; gap: clamp(2rem, 7vw, 6rem); }
    .principle-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    .principle-cards article { padding: 1.35rem; border-radius: 16px; background: #edf6f7; }
    .principle-cards span { color: #006b65; font: 800 .72rem/1 ui-monospace, monospace; }
    .principle-cards h3 { margin: .7rem 0 .4rem; font-size: 1.04rem; }
    .principle-cards p { margin: 0; color: #576d79; font-size: .9rem; line-height: 1.6; }
    .impact-close { padding: 4.5rem 0; color: #ecfbff; background: linear-gradient(135deg, #073b42, #092035); }
    .impact-close-inner { display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
    .impact-close-inner > div { max-width: 720px; }
    .impact-close p:last-child { color: rgba(231, 247, 251, .72); line-height: 1.65; }
    .impact-close a { flex: 0 0 auto; color: #032328; background: #67efdf; }
    @media (max-width: 850px) {
      .signal-grid { grid-template-columns: 1fr 1fr; }
      .principles-grid { grid-template-columns: 1fr; }
      .impact-close-inner { align-items: flex-start; flex-direction: column; }
    }
    @media (max-width: 600px) {
      .impact-wrap { width: min(100% - 1.5rem, 1120px); }
      .impact-heading { align-items: flex-start; flex-direction: column; }
      .signal-grid, .principle-cards { grid-template-columns: 1fr; }
      .measure-row { grid-template-columns: 42px 1fr; }
    }
  </style>
</Base>
