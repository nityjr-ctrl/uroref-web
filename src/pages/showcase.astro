---
import Base from '../layouts/Base.astro';
import ModelExperience from '../components/ModelExperience.astro';
import { getCollection } from 'astro:content';
import {
  CONTENT_VERSION,
  LINK_CHECKED_LABEL,
  ecosystemProjects,
  evidenceResources,
  technologyCapabilities,
} from '../data/ecosystem';

const articles = await getCollection('deep-dives');
const monthOrder: Record<string, number> = {
  January: 1, February: 2, March: 3, April: 4, May: 5, June: 6,
  July: 7, August: 8, September: 9, October: 10, November: 11, December: 12,
};
const latestArticles = [...articles].sort((a, b) => {
  const [aMonth, aYear] = a.data.date.split(' ');
  const [bMonth, bYear] = b.data.date.split(' ');
  return Number(bYear) - Number(aYear) || monthOrder[bMonth] - monthOrder[aMonth];
}).slice(0, 3);

const projectById = Object.fromEntries(ecosystemProjects.map((project) => [project.id, project]));
const stoneJourney = [projectById.uroref, projectById.calyxview, projectById.uroops3d];
---

<Base
  title="Mega Hub showcase"
  description="Explore the connected UroRef ecosystem: source-labelled clinical education, evidence discovery, spatial anatomy and browser-based teaching tools."
>
  <div class="showcase" data-showcase data-content-version={CONTENT_VERSION}>
    <section class="showcase-hero" data-chapter="Opening" aria-labelledby="showcase-title">
      <div class="showcase-grid" aria-hidden="true"></div>
      <div class="showcase-hero-inner">
        <div class="showcase-hero-copy">
          <div class="showcase-pill"><span></span> UroRef showcase · for discussion</div>
          <h1 id="showcase-title">One stone. <em>One source-led learning journey.</em></h1>
          <p class="showcase-lead">
            UroRef connects concise trainee reference, direct routes to authoritative sources and browser-based spatial teaching—without pretending that education is clinical decision support.
          </p>
          <div class="showcase-actions">
            <a class="u-cta-primary" href="#stone-journey" data-umami-event="showcase-follow-stone">Follow the stone ↓</a>
            <a class="u-cta-ghost" href="#evidence-desk">Open the evidence desk</a>
            <button class="showcase-present-button" type="button" data-presentation-start>Start guided view</button>
          </div>
          <div class="showcase-proof" aria-label="Showcase boundaries">
            <span><b>{ecosystemProjects.length}</b> public projects</span>
            <span><b>3</b>-project stone journey</span>
            <span>Education only</span>
            <span>{LINK_CHECKED_LABEL}</span>
          </div>
        </div>

        <div class="ecosystem-orbit" aria-label="The five connected UroRef projects">
          <div class="orbit-ring orbit-ring-one" aria-hidden="true"></div>
          <div class="orbit-ring orbit-ring-two" aria-hidden="true"></div>
          <a class="orbit-core" href="#uroref" style={`--node:${projectById.uroref.accent}`}>
            <span>Uro</span><strong>Ref</strong><small>source layer</small>
          </a>
          {ecosystemProjects.filter((project) => project.id !== 'uroref').map((project, index) => (
            <a class={`orbit-node orbit-node-${index + 1}`} href={`#${project.id}`} style={`--node:${project.accent}`}>
              <span>{project.mark}</span>
              <strong>{project.name}</strong>
              <small>{project.category}</small>
            </a>
          ))}
          <p class="orbit-caption">One knowledge spine · purpose-built experiences</p>
        </div>
      </div>
    </section>

    <nav class="showcase-rail" aria-label="Showcase sections" data-pagefind-ignore>
      <a href="#stone-journey">Stone journey</a>
      <a href="#ecosystem">Five projects</a>
      <a href="#evidence-desk">Evidence desk</a>
      <a href="#spatial-layer">3D layer</a>
      <a href="#technology">Technology</a>
      <a href="#pilot">90-day pilot</a>
    </nav>

    <section id="stone-journey" class="showcase-section journey-section" data-chapter="Stone journey" aria-labelledby="journey-title">
      <div class="section-heading">
        <p class="section-kicker">One teaching stone · no patient record</p>
        <h2 id="journey-title">From source, to anatomy, to hazard rehearsal.</h2>
        <p>The objective is not to select treatment. It is to show how a learner can move through three complementary modes while the use boundary stays visible.</p>
      </div>

      <div class="journey-grid">
        {stoneJourney.map((project, index) => (
          <article class="journey-card" style={`--journey-accent:${project.accent}`} id={`journey-${project.id}`}>
            <div class="journey-card-top">
              <span class="journey-index">0{index + 1}</span>
              <span class={`status-chip status-${project.stage}`}>{project.stageLabel}</span>
            </div>
            <p class="journey-project">{project.name}</p>
            <h3>{index === 0 ? 'Find the route, then open the source.' : index === 1 ? 'Make the collecting system spatial.' : 'Rehearse the danger before the viva.'}</h3>
            <p>{project.longDescription}</p>
            <div class="boundary-note"><b>Boundary</b>{project.safetyNotice}</div>
            <a
              href={project.localHref ?? project.href}
              target={project.id === 'uroref' ? undefined : '_blank'}
              rel={project.id === 'uroref' ? undefined : 'noopener'}
              data-umami-event={`showcase-open-${project.id}`}
            >
              {project.id === 'uroref' ? 'Open UroRef' : 'Open project in a new tab'} →
            </a>
          </article>
        ))}
      </div>

      <div class="ariadne-demo" aria-labelledby="ariadne-demo-title">
        <div class="ariadne-window">
          <div class="ariadne-window-top"><span></span><span></span><span></span><b>Ask Ariadne · safe demonstration</b></div>
          <div class="ariadne-question">
            <span>You</span>
            <p>Where should I start when teaching the stone pathway?</p>
          </div>
          <div class="ariadne-answer">
            <span>Ariadne</span>
            <p>
              Start with the UroRef stone route, then open the original NICE and EAU guidance. Use CalyxView for collecting-system orientation and UrOops3D for hazard rehearsal. Local policy, senior advice and the original sources remain authoritative.
            </p>
            <div class="ariadne-citations">
              <a href="https://www.nice.org.uk/guidance/ng118" target="_blank" rel="noopener">NICE NG118 ↗</a>
              <a href="https://uroweb.org/guidelines/urolithiasis" target="_blank" rel="noopener">EAU Urolithiasis 2026 ↗</a>
            </div>
          </div>
        </div>
        <div class="ariadne-trust">
          <p class="section-kicker">The trust layer is visible</p>
          <h3>A cited route, not a hidden answer.</h3>
          <ul>
            <li>Uses a synthetic educational question.</li>
            <li>Links directly to the original source.</li>
            <li>Names jurisdiction and known scope boundaries.</li>
            <li>Does not accept patient-identifiable information.</li>
            <li>Live-model safety is evaluated separately before claims are made.</li>
          </ul>
          <a href="/privacy">Read how Ask Ariadne handles data →</a>
        </div>
      </div>
    </section>

    <section id="ecosystem" class="showcase-section ecosystem-section" data-chapter="Five projects" aria-labelledby="ecosystem-title">
      <div class="section-heading section-heading-split">
        <div>
          <p class="section-kicker">The connected portfolio</p>
          <h2 id="ecosystem-title">One spine. Five distinct jobs.</h2>
        </div>
        <p>The projects keep their own visual identities while sharing one vocabulary for maturity, provenance and safety.</p>
      </div>

      <div class="portfolio-grid">
        {ecosystemProjects.map((project, index) => (
          <article id={project.id} class={`portfolio-card portfolio-card-${index + 1}`} style={`--project:${project.accent}`}>
            <div class="portfolio-visual" aria-hidden="true">
              <span class="portfolio-mark">{project.mark}</span>
              <div class="portfolio-wave"></div>
              <div class="portfolio-frame"><i></i><i></i><i></i></div>
            </div>
            <div class="portfolio-copy">
              <div class="portfolio-meta"><span>{project.category}</span><span>{project.stageLabel}</span></div>
              <h3>{project.name}</h3>
              <p>{project.description}</p>
              <div class="boundary-note"><b>Use boundary</b>{project.safetyNotice}</div>
              <div class="portfolio-actions">
                <a href={project.localHref ?? project.href} target={project.external ? '_blank' : undefined} rel={project.external ? 'noopener' : undefined}>
                  {project.external ? 'Open project ↗' : 'Open project →'}
                </a>
                {project.demoLinks?.[0] && <a href={project.demoLinks[0].href} target="_blank" rel="noopener">Open demo in a new tab ↗</a>}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="evidence-desk" class="showcase-section evidence-section" data-chapter="Evidence desk" aria-labelledby="evidence-title">
      <div class="section-heading section-heading-split">
        <div>
          <p class="section-kicker">The source is part of the answer</p>
          <h2 id="evidence-title">An evidence desk with visible boundaries.</h2>
        </div>
        <p>Issuer, source type, jurisdiction, access, date and scope travel with every resource. “Link checked” never means clinically validated.</p>
      </div>

      <div class="evidence-grid">
        {evidenceResources.map((resource) => (
          <article class="evidence-card">
            <div class="evidence-meta">
              <span>{resource.issuer}</span><span>{resource.type}</span><span>{resource.jurisdiction}</span><span>{resource.access}</span>
            </div>
            <h3>{resource.title}</h3>
            <p>{resource.summary}</p>
            <dl>
              <div><dt>Current marker</dt><dd>{resource.dateLabel}</dd></div>
              <div><dt>Use boundary</dt><dd>{resource.boundary}</dd></div>
            </dl>
            <a href={resource.href} target="_blank" rel="noopener">Open original source ↗</a>
          </article>
        ))}
      </div>

      <div class="latest-strip" aria-labelledby="latest-title">
        <div><p class="section-kicker">Latest from UroRef</p><h3 id="latest-title">Fresh thinking, correctly ordered.</h3></div>
        <div class="latest-list">
          {latestArticles.map((article) => (
            <a href={`/deep-dives/${article.id}`}>
              <span>{article.data.date}</span>
              <strong>{article.data.title}</strong>
              <small>{article.data.description}</small>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="spatial-layer" class="showcase-section spatial-section" data-chapter="3D layer" aria-labelledby="spatial-title">
      <div class="section-heading">
        <p class="section-kicker">A reusable spatial layer</p>
        <h2 id="spatial-title">The model lives inside the learning journey.</h2>
        <p>A locally hosted public teaching asset demonstrates Google model-viewer, with a static image that remains useful if WebGL or the web component fails.</p>
      </div>
      <ModelExperience />
    </section>

    <section id="technology" class="showcase-section technology-section" data-chapter="Technology" aria-labelledby="technology-title">
      <div class="section-heading section-heading-split">
        <div>
          <p class="section-kicker">Technology, with the claims kept honest</p>
          <h2 id="technology-title">Integrated where safe. Gated where necessary.</h2>
        </div>
        <p>A repository is not a clinical capability by itself. Each component below states what is working now and what still needs infrastructure or governance.</p>
      </div>

      <div class="technology-grid">
        {technologyCapabilities.map((technology, index) => (
          <article class="technology-card">
            <div class="technology-index">{String(index + 1).padStart(2, '0')}</div>
            <div>
              <div class="technology-top"><h3>{technology.name}</h3><span class={`tech-${technology.status}`}>{technology.statusLabel}</span></div>
              <p>{technology.summary}</p>
              <small>{technology.implementation}</small>
              <a href={technology.href} target="_blank" rel="noopener">Open repository ↗</a>
            </div>
          </article>
        ))}
      </div>

      <div class="imaging-bridge">
        <div>
          <p class="section-kicker">Synthetic imaging bridge</p>
          <h3>OHIF, Cornerstone3D and MONAI have a clearly separated landing zone.</h3>
          <p>The public hub contains no DICOM server, no NHS study and no live inference. The imaging lab documents the future connection boundary and demonstrates only public research teaching assets.</p>
        </div>
        <a class="u-cta-ghost" href="/imaging-lab">Open the imaging lab →</a>
      </div>
    </section>

    <section id="pilot" class="pilot-section" data-chapter="90-day pilot" aria-labelledby="pilot-title">
      <div class="pilot-glow" aria-hidden="true"></div>
      <div class="pilot-copy">
        <p class="section-kicker">A bounded next step</p>
        <h2 id="pilot-title">Test one pathway before discussing a platform.</h2>
        <p class="pilot-lead">A 90-day co-design pilot around one stone journey: one endourology clinical lead, one trainee and one patient representative.</p>
        <div class="pilot-deliverables">
          <span>One reviewed learning route</span>
          <span>Direct original-source links</span>
          <span>Owner and review date</span>
          <span>Accessibility and claims review</span>
          <span>Day-90 evidence report</span>
        </div>
        <p class="pilot-boundary"><b>No patient data.</b> No EPR integration. No prescribing or patient-specific recommendation. No claim of BAUS endorsement, clinical competence or improved patient outcomes.</p>
        <div class="pilot-actions">
          <a class="u-cta-primary" href="mailto:nity@uroref.com?subject=UroRef%2090-day%20stone%20pilot">Discuss the 90-day pilot →</a>
          <a class="u-cta-ghost" href="/nity">Open the presenter profile</a>
        </div>
      </div>
      <div class="pilot-handoff">
        <img src="/publicity/nity-g/nity-g-qr-white.svg" alt="QR code opening Nity G's UroRef profile" width="240" height="240" loading="lazy" />
        <strong>Take the ecosystem with you.</strong>
        <span>Contact, live projects and presentation links.</span>
      </div>
    </section>

    <div class="presentation-controls" data-presentation-controls hidden data-pagefind-ignore>
      <button type="button" data-presentation-exit aria-label="Exit guided view">×</button>
      <span data-presentation-label aria-live="polite" aria-atomic="true">Opening</span>
      <div>
        <button type="button" data-presentation-prev aria-label="Previous section">←</button>
        <span data-presentation-count>1 / 7</span>
        <button type="button" data-presentation-next aria-label="Next section">→</button>
      </div>
    </div>
  </div>

  <script>
    const setupPresentation = () => {
      const root = document.querySelector('[data-showcase]');
      if (!(root instanceof HTMLElement) || root.dataset.presentationReady === 'true') return;
      root.dataset.presentationReady = 'true';
      const chapters = Array.from(root.querySelectorAll('[data-chapter]'));
      const start = root.querySelector('[data-presentation-start]');
      const controls = root.querySelector('[data-presentation-controls]');
      const exitButton = root.querySelector('[data-presentation-exit]');
      const label = root.querySelector('[data-presentation-label]');
      const count = root.querySelector('[data-presentation-count]');
      let index = 0;

      const sync = () => {
        const chapter = chapters[index];
        if (!(chapter instanceof HTMLElement)) return;
        if (label) label.textContent = chapter.dataset.chapter || 'Showcase';
        if (count) count.textContent = `${index + 1} / ${chapters.length}`;
      };
      const go = (nextIndex) => {
        index = Math.max(0, Math.min(chapters.length - 1, nextIndex));
        chapters[index]?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
        sync();
      };
      const exit = () => {
        document.documentElement.classList.remove('showcase-presenting');
        if (controls instanceof HTMLElement) controls.hidden = true;
        if (document.fullscreenElement) document.exitFullscreen().catch(() => {});
        if (start instanceof HTMLElement) start.focus();
      };
      const begin = () => {
        document.documentElement.classList.add('showcase-presenting');
        if (controls instanceof HTMLElement) controls.hidden = false;
        index = 0;
        sync();
        chapters[0]?.scrollIntoView({ block: 'start' });
        document.documentElement.requestFullscreen?.().catch(() => {});
        requestAnimationFrame(() => {
          if (exitButton instanceof HTMLElement) exitButton.focus();
        });
      };

      start?.addEventListener('click', begin);
      exitButton?.addEventListener('click', exit);
      root.querySelector('[data-presentation-prev]')?.addEventListener('click', () => go(index - 1));
      root.querySelector('[data-presentation-next]')?.addEventListener('click', () => go(index + 1));
      document.addEventListener('keydown', (event) => {
        if (!document.documentElement.classList.contains('showcase-presenting')) return;
        if (event.key === 'Escape') exit();
        if (['ArrowRight', 'PageDown'].includes(event.key)) { event.preventDefault(); go(index + 1); }
        if (['ArrowLeft', 'PageUp'].includes(event.key)) { event.preventDefault(); go(index - 1); }
      });
      document.addEventListener('fullscreenchange', () => {
        if (!document.fullscreenElement && document.documentElement.classList.contains('showcase-presenting')) exit();
      });
      const observer = new IntersectionObserver((entries) => {
        const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        const next = chapters.indexOf(visible?.target);
        if (next >= 0) { index = next; sync(); }
      }, { threshold: [.35, .65] });
      chapters.forEach((chapter) => observer.observe(chapter));
    };
    setupPresentation();
    document.addEventListener('astro:page-load', setupPresentation);
  </script>

  <style>
    .showcase { --showcase-bg: #061423; background: var(--showcase-bg); overflow: clip; }
    .showcase-hero { position: relative; min-height: calc(100svh - 82px); display: grid; align-items: center; padding: clamp(72px, 9vw, 122px) 32px; isolation: isolate; background: radial-gradient(circle at 72% 40%, rgba(0,212,200,.12), transparent 33%), linear-gradient(145deg, #06111f, #0a2540 64%, #061827); }
    .showcase-grid { position: absolute; inset: 0; z-index: -1; opacity: .42; background-image: linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px); background-size: 54px 54px; mask-image: linear-gradient(to bottom, black, transparent 90%); }
    .showcase-hero-inner { width: min(1240px, 100%); margin: 0 auto; display: grid; grid-template-columns: minmax(0, 1fr) minmax(420px, .9fr); gap: clamp(40px, 7vw, 90px); align-items: center; }
    .showcase-pill { display: inline-flex; align-items: center; gap: 9px; padding: 7px 11px; border: 1px solid rgba(0,212,200,.3); border-radius: 999px; background: rgba(0,212,200,.07); color: var(--teal-500); font: 500 10px var(--font-mono); letter-spacing: .12em; text-transform: uppercase; }
    .showcase-pill span { width: 6px; height: 6px; border-radius: 50%; background: var(--teal-500); box-shadow: 0 0 18px var(--teal-500); }
    .showcase-hero h1 { margin: 24px 0; max-width: 11ch; font-size: clamp(54px, 7.2vw, 104px); line-height: .91; letter-spacing: -.065em; text-wrap: balance; }
    .showcase-hero h1 em { color: var(--teal-500); font: italic 500 .76em var(--font-serif); letter-spacing: -.04em; }
    .showcase-lead { max-width: 62ch; margin: 0; color: var(--text-secondary); font: clamp(17px, 2vw, 20px)/1.65 var(--font-serif); }
    .showcase-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 30px; }
    .showcase-present-button { padding: 13px 18px; border: 1px solid rgba(246,196,83,.45); border-radius: 999px; background: rgba(246,196,83,.08); color: #ffe49a; font-weight: 650; cursor: pointer; }
    .showcase-present-button:hover { background: rgba(246,196,83,.15); }
    .showcase-proof { display: flex; flex-wrap: wrap; gap: 10px 20px; margin-top: 28px; color: var(--text-muted); font: 10px var(--font-mono); letter-spacing: .05em; text-transform: uppercase; }
    .showcase-proof span { position: relative; }
    .showcase-proof span:not(:last-child)::after { content: ''; position: absolute; top: 50%; right: -12px; width: 3px; height: 3px; border-radius: 50%; background: var(--teal-500); }
    .showcase-proof b { color: white; }
    .ecosystem-orbit { position: relative; aspect-ratio: 1; min-height: 500px; border: 1px solid rgba(255,255,255,.1); border-radius: 38px; background: radial-gradient(circle at center, rgba(0,212,200,.14), transparent 22%), linear-gradient(150deg, rgba(255,255,255,.045), rgba(255,255,255,.012)); box-shadow: inset 0 1px rgba(255,255,255,.08), 0 40px 100px -60px rgba(0,212,200,.8); }
    .orbit-ring { position: absolute; left: 50%; top: 50%; border: 1px solid rgba(255,255,255,.11); border-radius: 50%; transform: translate(-50%, -50%); }
    .orbit-ring-one { width: 56%; height: 56%; }
    .orbit-ring-two { width: 82%; height: 82%; border-style: dashed; animation: orbit-spin 42s linear infinite; }
    @keyframes orbit-spin { to { transform: translate(-50%, -50%) rotate(360deg); } }
    .orbit-core, .orbit-node { position: absolute; z-index: 2; display: grid; place-items: center; text-align: center; border: 1px solid color-mix(in srgb, var(--node) 54%, transparent); background: color-mix(in srgb, var(--node) 8%, #071321); box-shadow: 0 16px 44px -26px var(--node); transition: transform .2s ease, border-color .2s ease; }
    .orbit-core:hover, .orbit-node:hover { transform: translate(-50%, -50%) scale(1.04); border-color: var(--node); }
    .orbit-core { left: 50%; top: 50%; width: 150px; height: 150px; border-radius: 50%; transform: translate(-50%, -50%); }
    .orbit-core span, .orbit-core strong { display: inline; font-size: 26px; line-height: .8; }
    .orbit-core strong { color: var(--teal-500); }
    .orbit-core small, .orbit-node small { color: var(--text-muted); font: 8px/1.4 var(--font-mono); letter-spacing: .08em; text-transform: uppercase; }
    .orbit-node { width: 120px; min-height: 104px; padding: 13px 9px; border-radius: 25px; transform: translate(-50%, -50%); }
    .orbit-node > span { display: grid; place-items: center; width: 31px; height: 31px; margin-bottom: 4px; border-radius: 10px; background: color-mix(in srgb, var(--node) 16%, transparent); color: var(--node); font: 600 10px var(--font-mono); }
    .orbit-node strong { font-size: 12px; }
    .orbit-node-1 { left: 50%; top: 10%; }
    .orbit-node-2 { left: 88%; top: 49%; }
    .orbit-node-3 { left: 50%; top: 88%; }
    .orbit-node-4 { left: 12%; top: 49%; }
    .orbit-caption { position: absolute; left: 0; right: 0; bottom: 15px; margin: 0; color: var(--text-muted); text-align: center; font: 9px var(--font-mono); letter-spacing: .12em; text-transform: uppercase; }
    .showcase-rail { position: sticky; z-index: 35; top: 81px; display: flex; justify-content: center; gap: 6px; overflow-x: auto; padding: 10px 20px; border-block: 1px solid var(--border); background: rgba(5,15,28,.9); backdrop-filter: blur(16px); scrollbar-width: none; }
    .showcase-rail::-webkit-scrollbar { display: none; }
    .showcase-rail a { flex: 0 0 auto; padding: 7px 11px; border-radius: 999px; color: var(--text-muted); font: 10px var(--font-mono); letter-spacing: .04em; }
    .showcase-rail a:hover { color: white; background: rgba(255,255,255,.06); }
    .showcase-section { width: min(1200px, calc(100% - 48px)); margin: 0 auto; padding: clamp(82px, 10vw, 140px) 0; scroll-margin-top: 120px; }
    .section-heading { max-width: 820px; margin-bottom: 50px; }
    .section-heading-split { max-width: none; display: grid; grid-template-columns: 1fr minmax(280px, .7fr); gap: 50px; align-items: end; }
    .section-kicker { margin: 0 0 14px; color: var(--teal-500); font: 500 10px var(--font-mono); letter-spacing: .16em; text-transform: uppercase; }
    .section-heading h2, .pilot-section h2 { margin: 0; max-width: 16ch; font-size: clamp(42px, 6vw, 76px); line-height: .98; letter-spacing: -.055em; text-wrap: balance; }
    .section-heading > p:last-child, .section-heading-split > p { margin: 20px 0 0; color: var(--text-secondary); font: 17px/1.65 var(--font-serif); }
    .section-heading-split > p { margin: 0; }
    .journey-section { width: min(1260px, calc(100% - 48px)); }
    .journey-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
